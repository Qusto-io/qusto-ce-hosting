# Copy to .env and fill in. Never commit .env.

# Required ---------------------------------------------------------------
# The public URL people will use, including scheme. No trailing slash.
BASE_URL=https://analytics.example.com
# 64+ random bytes: openssl rand -base64 48
SECRET_KEY_BASE=

# Recommended ------------------------------------------------------------
# Base64-encoded 32 bytes, for 2FA secrets: openssl rand -base64 32
TOTP_VAULT_KEY=
# After you have created your own account: true | invite_only | false
DISABLE_REGISTRATION=invite_only

# Built-in HTTPS (Let's Encrypt). Leave unset when a reverse proxy terminates TLS.
# HTTP_PORT=80
# HTTPS_PORT=443

# Privacy defaults (Qusto) -----------------------------------------------
# "*" masks the IP used for the visitor hash on every site. Recommended.
IP_MASK_DOMAINS=*
# Whether you need consent depends on your market and setup.
# CONSENT_REQUIRED=true drops every event that does not carry the tracker's
# consent prop ("consent": "true"). Off by default, as in upstream Plausible.
# CONSENT_AGGREGATE_DOMAINS lists sites that may keep their no-consent pageview.
# CONSENT_REQUIRED=false
# CONSENT_AGGREGATE_DOMAINS=

# Pin a specific image instead of the compose default.
# QUSTO_CE_IMAGE=ghcr.io/qusto-io/qusto-ce-community:v1.0.0
